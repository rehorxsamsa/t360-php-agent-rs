{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(docker compose exec -T app composer *)",
      "Bash(docker compose exec -T app php *)",
      "Bash(docker compose exec -T app vendor/bin/*)",
      "Bash(docker compose exec app composer *)",
      "Bash(docker compose exec app php *)",
      "Bash(docker compose exec app vendor/bin/*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose up*)",
      "Bash(docker compose stop*)",
      "Bash(docker compose start*)",
      "Bash(docker compose restart*)",
      "Bash(docker compose build*)",
      "Bash(docker compose pull*)",
      "Bash(docker compose images*)",
      "Bash(docker compose port*)",
      "Bash(docker compose config --quiet*)",
      "Bash(docker run --rm rhysd/actionlint*)",
      "Bash(make up)",
      "Bash(make down)",
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make qa)",
      "Bash(make fix)",
      "Bash(make ps)",
      "Bash(make logs)",
      "Bash(make help)",
      "Bash(git status*)",
      "Bash(git diff --stat*)",
      "Bash(git diff HEAD*)",
      "Bash(git log --oneline*)",
      "Bash(git show --stat*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git restore --staged -- *)",
      "Bash(git ls-files*)",
      "Bash(git branch --show-current)",
      "Bash(ls *)",
      "Bash(jq *)",
      "Bash(curl -s http://localhost:8080/*)",
      "Bash(curl -sS http://localhost:8080/*)",
      "mcp__context7",
      "mcp__playwright",
      "mcp__mariadb-cteni"
    ],
    "ask": [
      "Bash(git reset *)",
      "Bash(git checkout -- *)",
      "Bash(git clean *)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose run *)",
      "Bash(docker compose exec * composer require *)",
      "WebFetch"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git * --force*)",
      "Bash(git * --output*)",
      "Bash(git * --no-index*)",
      "Bash(git * --pathspec*)",
      "Bash(git restore * --wor*)",
      "Bash(git restore * --so*)",
      "Bash(curl * -o *)",
      "Bash(curl * file:*)",
      "Bash(sudo *)",
      "Bash(php *)",
      "Bash(composer *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(printenv*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.prod)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.prod)",
      "mcp__github__create_*",
      "mcp__github__update_*",
      "mcp__github__delete_*",
      "mcp__github__merge_*",
      "mcp__github__push_*"
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "6"
  },
  "enabledMcpjsonServers": ["context7", "github"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          { "type": "command", "command": "bash", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/kontext-relace.sh"], "timeout": 20 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/bash-strazce.sh"], "timeout": 10 },
          { "type": "command", "if": "Bash(git commit *)", "command": "bash", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/commit-brana.sh"], "timeout": 30, "statusMessage": "Kontroluji tajemství v commitu…" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/chran-soubory.sh"], "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/php-lint.sh"], "timeout": 60, "statusMessage": "php -l …" }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "bash", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/audit-log.sh"], "async": true }
        ]
      }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/audit-log.sh"], "async": true } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/audit-log.sh"], "async": true } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/pripominka-commit.sh"], "timeout": 10 } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/notifikace.sh"], "timeout": 5 } ] }
    ]
  }
}
