# Vývojové prostředí. `make up` z tohoto souboru vytvoří .env (necommituje se).
# Hodnoty níže jsou ukázkové a NEJSOU tajné – v produkci je nahraď vlastními.

# --- Compose ---
# Výslovně jen compose.yaml: Compose jinak sám načte i compose.override.y*ml (obejití pojistek).
COMPOSE_FILE=compose.yaml

# --- Aplikace ---
APP_ENV=dev
APP_DEBUG=1
APP_URL=http://localhost:8080
# AI: falesny = bez sítě a bez útraty; anthropic vyžaduje ANTHROPIC_API_KEY (klíč nikdy necommitovat).
AI_PROVIDER=falesny
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MODEL_LEVNY=claude-haiku-4-5-20251001
AI_DENNI_LIMIT_TOKENU=200000

# --- UID/GID uživatele v kontejneru app (shodné s tvým uživatelem: `id -u`, `id -g`) ---
HOST_UID=1000
HOST_GID=1000

# --- Databáze ---
DB_HOST=db
DB_PORT=3306
DB_NAME=redakce
DB_USER=redakce_app
DB_PASSWORD=dev-app-heslo
DB_MIGRACE_PASSWORD=dev-migrace-heslo
DB_READONLY_PASSWORD=dev-cteni-heslo
MARIADB_ROOT_PASSWORD=dev-root-heslo

# PRODUKCE (zkopíruj do /opt/redakce/.env na serveru a vyplň; zde zakomentováno, bez hodnot)
# APP_ENV=
# APP_DEBUG=
# APP_URL=
# IMAGE_OWNER=
# MARIADB_ROOT_PASSWORD=
# DB_PASSWORD=
# DB_MIGRACE_PASSWORD=
# DB_READONLY_PASSWORD=
# AI_PROVIDER=
# SESSION_COOKIE_SECURE=1
# ANTHROPIC_API_KEY=
# AI_MODEL=
# AI_MODEL_LEVNY=
# AI_DENNI_LIMIT_TOKENU=
# WEB_PORT=
# TRUSTED_PROXIES=
# COMPOSE_PROFILES=
# DOMENA=
