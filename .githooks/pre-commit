#!/usr/bin/env bash
# Git hook: rychlá kontrola před commitem (syntaxe PHP ve staged souborech).
FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.php$' || true)
[ -z "$FILES" ] && exit 0
if [ -n "$(docker compose ps -q --status running app 2>/dev/null)" ]; then
  for f in $FILES; do docker compose exec -T app php -l "/app/$f" >/dev/null || { echo "✗ Syntaktická chyba: $f" >&2; exit 1; }; done
fi
exit 0
